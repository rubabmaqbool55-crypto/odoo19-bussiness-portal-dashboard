<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_business_portal_ticket_list" model="ir.ui.view">
        <field name="name">business.portal.ticket.list</field>
        <field name="model">business.portal.ticket</field>
        <field name="arch" type="xml">
            <list string="Support Tickets" default_order="create_date desc">
                <field name="name"/>
                <field name="subject"/>
                <field name="partner_id"/>
                <field name="contact_id"/>
                <field name="category"/>
                <field name="priority" widget="priority"/>
                <field name="state"/>
                <field name="resolution_type" optional="show"/>
                <field name="resolution_expected_date" optional="hide"/>
                <field name="resolution_completed_date" optional="hide"/>
                <field name="customer_reply_status" optional="show"/>
                <field name="customer_reply_pending_review" optional="show"/>
                <field name="assigned_user_id" widget="many2one_avatar_user"/>
                <field name="related_reference" optional="show"/>
                <field name="create_date" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_business_portal_ticket_form" model="ir.ui.view">
        <field name="name">business.portal.ticket.form</field>
        <field name="model">business.portal.ticket</field>
        <field name="arch" type="xml">
            <form string="Support Ticket">
                <header>
                    <button
                        name="action_set_in_progress"
                        type="object"
                        string="Start / Continue Progress"
                        class="btn-primary"
                        invisible="state not in ('new', 'waiting_customer')"
                    />
                    <button
                        name="action_waiting_customer"
                        type="object"
                        string="Request Customer Info"
                        invisible="state not in ('new', 'in_progress')"
                    />
                    <button
                        name="action_resolve"
                        type="object"
                        string="Resolve"
                        class="btn-primary"
                        invisible="state not in ('new', 'in_progress', 'waiting_customer')"
                    />
                    <button
                        name="action_close"
                        type="object"
                        string="Close"
                        class="btn-primary"
                        invisible="state != 'resolved'"
                    />
                    <button
                        name="action_reopen"
                        type="object"
                        string="Reopen"
                        invisible="state not in ('resolved', 'closed', 'cancelled')"
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        readonly="1"
                        statusbar_visible="new,in_progress,waiting_customer,resolved,closed"
                    />
                </header>

                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Customer Replied"
                        bg_color="text-bg-warning"
                        invisible="not customer_reply_pending_review"
                    />

                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                        <h2><field name="subject" placeholder="Ticket subject"/></h2>
                    </div>

                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="contact_id"/>
                            <field name="category"/>
                            <field name="priority" widget="priority"/>
                        </group>
                        <group>
                            <field name="assigned_user_id" widget="many2one_avatar_user"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="date_opened" readonly="1"/>
                            <field name="date_resolved" readonly="1"/>
                        </group>
                    </group>

                    <group string="Related Document">
                        <field name="related_model"/>
                        <field name="related_res_id"/>
                        <field name="related_reference"/>
                        <field name="related_url" widget="url"/>
                    </group>

                    <group string="Customer Description">
                        <field
                            name="description"
                            nolabel="1"
                            placeholder="Customer issue or request"
                        />
                    </group>

                    <group string="Resolution &amp; Fulfilment" col="2">
                        <field
                            name="resolution_type"
                            readonly="state == 'closed'"
                        />
                        <field
                            name="resolution_expected_date"
                            invisible="resolution_type not in ('replacement', 'refund', 'repair')"
                            required="resolution_type in ('replacement', 'refund', 'repair')"
                            readonly="state == 'closed'"
                        />
                        <field
                            name="replacement_picking_id"
                            invisible="resolution_type != 'replacement'"
                            required="resolution_type == 'replacement'"
                            readonly="state == 'closed'"
                            domain="[('picking_type_code', '=', 'outgoing'), ('company_id', '=', company_id)]"
                        />
                        <field
                            name="replacement_tracking_reference"
                            invisible="resolution_type != 'replacement'"
                            readonly="state == 'closed'"
                        />
                        <field
                            name="refund_amount"
                            invisible="resolution_type != 'refund'"
                            required="resolution_type == 'refund'"
                            readonly="state == 'closed'"
                        />
                        <field name="currency_id" invisible="1"/>
                        <field
                            name="credit_note_id"
                            string="Refund Credit Note"
                            invisible="resolution_type not in ('refund', 'credit_note')"
                            required="resolution_type == 'credit_note'"
                            readonly="state == 'closed'"
                            options="{'no_create': True}"
                            domain="[('move_type', 'in', ('out_refund', 'in_refund')), ('state', '=', 'posted'), ('company_id', '=', company_id)]"
                            help="For a refund, select the posted credit note created by Accounting. The ticket can close only after this credit note is fully paid and reconciled."
                        />
                        <field
                            name="resolution_completed_date"
                            invisible="state not in ('resolved', 'closed')"
                            readonly="state == 'closed' or resolution_type in ('refund', 'replacement')"
                            help="For refunds and replacements this date is verified and filled by the system. For repairs, enter it after the work is actually completed."
                        />
                        <field
                            name="resolution_note"
                            nolabel="1"
                            colspan="2"
                            placeholder="Explain the approved solution to the customer..."
                            readonly="state == 'closed'"
                        />
                    </group>

                    <group string="Automatic Reply &amp; Response Tracking" col="2">
                        <field name="expected_reply_type" readonly="1"/>
                        <field name="customer_reply_status" readonly="1"/>
                        <field name="customer_reply_pending_review" readonly="1"/>
                        <field name="auto_reply_count" readonly="1"/>
                        <field name="last_customer_reply_at" readonly="1"/>
                        <field name="last_support_reply_at" readonly="1"/>
                        <field name="last_auto_reply_at" readonly="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

